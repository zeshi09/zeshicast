[Unit]
Description=Zeshicast GTK launcher daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@BIN@/zeshicast-gtk --daemon
Restart=on-failure
RestartSec=2

# Hardening (P4.1, вариант B). Здесь мало намеренно: systemd применяет эти
# директивы и к потомкам демона, а демон запускает приложения пользователя --
# mount namespace, seccomp, W^X и границы capabilities наследуются через
# fork+exec и ломают то, что из шелла работает. Что именно и почему убрано,
# перечислено в docs/security.md. Зеркален определениям в flake.nix.
#
# Намеренное отличие от запуска из шелла одно: setuid и файловые capabilities
# не срабатывают, поэтому sudo/pkexec из палитры не запустятся.
NoNewPrivileges=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=graphical-session.target
