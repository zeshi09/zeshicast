[Desktop Entry]
Type=Application
Name=Zeshicast Daemon
Comment=Keep Zeshicast launcher index warm
Exec=@BIN@/zeshicast-gtk --daemon
Icon=system-search-symbolic
Terminal=false
Categories=Utility;
StartupNotify=false
# Daemon mode still creates the launcher GTK window (hidden until summoned),
# so map its app-id to this entry too.
StartupWMClass=dev.zeshi.Zeshicast
X-GNOME-Autostart-enabled=true
