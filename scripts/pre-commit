#!/usr/bin/env bash
# Fast local gate before a commit (Q0.2): formatting and clippy on the default
# (GTK-free) build. The full matrix (desktop, gui, layer-shell) stays in CI and
# in docs/development.md "Test Strategy".
#
# Install once:  ln -s ../../scripts/pre-commit .git/hooks/pre-commit
# Skip once:     git commit --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Nothing Rust-related staged: nothing to check.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '(\.rs|Cargo\.(toml|lock)|rustfmt\.toml)$'; then
  exit 0
fi

echo "pre-commit: cargo fmt --check"
if ! cargo fmt --check; then
  echo "pre-commit: run 'cargo fmt' and re-stage the files" >&2
  exit 1
fi

echo "pre-commit: cargo clippy (default build)"
cargo clippy --all-targets --quiet -- -D warnings
